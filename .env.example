# Copy to .env and adjust as needed. Every value has a working default in
# docker-compose.yml, so the stack also starts without this file.

# --- PostgreSQL (used by the db service and the application) -----------------
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app
# Keep the webhook's failure path short: if the database is unreachable the
# endpoint answers 503 instead of hanging until the helpdesk times out.
DB_CONNECT_TIMEOUT_SECONDS=2
DB_POOL_TIMEOUT_SECONDS=2

# --- LLM provider (any OpenAI-compatible HTTP API) ---------------------------
# OpenAI:      https://api.openai.com/v1        model: gpt-4o-mini
# OpenRouter:  https://openrouter.ai/api/v1     model: openai/gpt-4o-mini
# Ollama:      http://host.docker.internal:11434/v1
# Leave LLM_API_KEY empty to run in keyless fallback mode: the service still
# performs a real provider request, then uses a static draft after a 5-30 s delay.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2
LLM_SIMULATED_DELAY_MIN=5
LLM_SIMULATED_DELAY_MAX=30
LLM_RATE_LIMIT_PER_MINUTE=60

# --- Worker ------------------------------------------------------------------
WORKER_CONCURRENCY=32
WORKER_POLL_INTERVAL_SECONDS=1
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=5

# --- Reply delivery ----------------------------------------------------------
HELPDESK_TIMEOUT_SECONDS=10
DELIVERY_MAX_ATTEMPTS=5
# Comma-separated host allowlist for reply_url (SSRF protection).
REPLY_URL_ALLOWED_HOSTS=api,localhost,127.0.0.1
MOCK_HELPDESK_INTERNAL_URL=http://api:8000

# --- Local only --------------------------------------------------------------
ENABLE_DEV_ENDPOINTS=true
